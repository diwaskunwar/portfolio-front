# Server-side only. Read exclusively by api/github-contributions.ts (a
# Vercel Edge Function). No `VITE_` prefix — that prefix makes Vite inline a
# variable's value into the client bundle as a plaintext string, which is
# how a token leaks. This one must never carry it.
#
# Needs no scopes: it authenticates a GraphQL request for public
# contribution data, which does not require any granted permission, only a
# valid token. A fine-grained PAT with zero repository access is enough.
GITHUB_TOKEN=

# Optional, defaults to "diwaskunwar" in code if unset. Public either way,
# so no risk in a VITE_-prefixed sibling if the client ever needs it too.
GITHUB_USERNAME=

# Present for a future use; nothing currently reads it.
GITHUB_ORG=
